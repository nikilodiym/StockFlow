# Copy to server/.env
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
# Postgres from docker compose (docker compose up -d db)
DATABASE_URL=postgres://stockflow:stockflow@localhost:5433/stockflow
# Optional: run pytest against Postgres instead of in-memory SQLite
# TEST_DATABASE_URL=postgres://stockflow:stockflow@localhost:5433/stockflow
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EXPO_PUSH_ENABLED=0
