{
  "name": "stockflow",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "mobile": "npm --prefix mobile start -- --clear",
    "mobile:android": "npm --prefix mobile run android -- --no-bundler",
    "db": "docker compose up -d db",
    "db:stop": "docker compose stop db",
    "migrate": "server\\.venv\\Scripts\\python.exe server/manage.py migrate",
    "api": "server\\.venv\\Scripts\\python.exe server/manage.py runserver 0.0.0.0:8000",
    "seed": "server\\.venv\\Scripts\\python.exe server/manage.py seed_demo",
    "test:api": "cd server && .venv\\Scripts\\python.exe -m pytest"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "expo": "~57.0.23",
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
