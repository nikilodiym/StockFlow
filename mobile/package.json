    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.14",
    "expo-print": "~58.0.7",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "query-string": "^9.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
